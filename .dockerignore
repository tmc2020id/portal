# ============================================================
# TMC SMART Website — .dockerignore
# Keeps the Docker build context lean and fast
# ============================================================

# --- Node / npm ---
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Next.js build output (rebuilt inside Docker) ---
.next
out

# --- Git ---
.git
.gitignore
.gitattributes

# --- Environment files (never bake secrets into the image) ---
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local

# --- Docker files themselves (no need to copy into the image) ---
Dockerfile
.dockerignore
docker-compose.yml
docker-compose*.yml

# --- Documentation ---
*.md
README*
AGENTS.md
CLAUDE.md
DELIVERY_REPORT.md

# --- IDE / OS ---
.DS_Store
.vscode
.idea
*.swp
*.swo
Thumbs.db

# --- TypeScript (rebuilt during build) ---
*.tsbuildinfo
