# ============================================================
# TMC SMART Website — Environment Variables
# ============================================================
# HOW TO USE:
#   cp .env.example .env
#   Edit .env with your actual values
#   Never commit .env to git (it is already in .gitignore)
#
# IMPORTANT — BUILD-TIME vs RUNTIME:
#   Variables prefixed with NEXT_PUBLIC_ are baked into the
#   JavaScript bundle at BUILD time by Next.js.
#   They must be set BEFORE running:
#     docker compose build
#     docker build ...
#
#   Changing them later requires a rebuild.
# ============================================================

# Site URL — used for sitemap.xml and robots.txt generation
# Example values:
#   https://www.tmcsmart.com   (production)
#   http://localhost:3000      (local testing / safer default)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
