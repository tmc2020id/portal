# ============================================================
# TMC SMART Website — Multi-stage Production Dockerfile
# Next.js 16 · React 19 · Node 20 Alpine · Standalone output
# ============================================================

# ---------- Stage 1: base image ----------
FROM node:20-alpine AS base
# libc6-compat is needed by some native Node addons on Alpine
RUN apk add --no-cache libc6-compat

# ---------- Stage 2: install dependencies ----------
FROM base AS deps
WORKDIR /app

# Copy package manifests first for better layer caching
COPY package.json package-lock.json* ./
RUN npm ci --frozen-lockfile

# ---------- Stage 3: build ----------
FROM base AS builder
WORKDIR /app

# Bring in installed modules from deps stage
COPY --from=deps /app/node_modules ./node_modules

# Copy source
COPY . .

# NEXT_PUBLIC_* vars are baked into the JS bundle at BUILD time.
# Default to localhost for safer local builds.
# Override for production with:
#   docker build --build-arg NEXT_PUBLIC_SITE_URL=https://www.tmcsmart.com
ARG NEXT_PUBLIC_SITE_URL=http://localhost:3000
ENV NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL}

# Disable Next.js telemetry during CI/build
ENV NEXT_TELEMETRY_DISABLED=1

RUN npm run build

# ---------- Stage 4: production runner ----------
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Create a non-root system user/group for security
RUN addgroup --system --gid 1001 nodejs \
 && adduser  --system --uid 1001 nextjs

# Pre-create .next dir with correct ownership
RUN mkdir .next && chown nextjs:nodejs .next

# Copy only the standalone output (smallest possible image)
# Ref: https://nextjs.org/docs/pages/api-reference/next-config-js/output
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static    ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public          ./public

USER nextjs

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# server.js is auto-generated by Next.js standalone build
CMD ["node", "server.js"]
